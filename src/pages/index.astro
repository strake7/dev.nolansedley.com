---
import { getCollection } from "astro:content"
import PostCard from "../components/PostCard.astro"
import SiteLayout from "../layouts/SiteLayout.astro"
import { sortPosts } from "../lib/posts"

const posts = sortPosts(await getCollection("posts"))
---

<SiteLayout>
  <section class="intro">
    <p>
      Notes on software systems, engineering leadership, and the space between
      them.
    </p>
  </section>

  <section class="writing-section" id="writing">
    <h2>Writing</h2>
    <ul class="post-list">
      {posts.map((post) => <li><PostCard post={post} /></li>)}
    </ul>
  </section>

  <section class="about-section" id="about">
    <h2>About</h2>
    <p>
      I’m Nolan, an engineering manager at Ontra, where I lead the teams
      shipping emerging AI products for private markets. Over 14 years I’ve
      gone deep on Ruby, .NET and JavaScript, building and scaling platforms at
      Mindbody, AppFolio and Ontra along the way.
    </p>
    <p>
      Lately, I’ve been focused on how to build and deploy agentic systems for
      production, client-facing applications.
    </p>
    <p class="about-links">
      <a href="https://www.linkedin.com/in/nsedley/">LinkedIn</a>
      <a href="https://github.com/strake7">GitHub</a>
    </p>
  </section>
</SiteLayout>
